# ===== LiveKit =====
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me-32chars-minimum-secret
# サーバ側 (管制室のRoom API) が使う内部URL。同一ホストなので平文でよい
LIVEKIT_URL=ws://localhost:7880
# ⚠ 管制室をHTTPSで公開するときは必須 (2026-07-30)。ブラウザに渡すURLはこちら。
#    HTTPSページから平文 ws:// には繋げず (SecurityError)、ブラウザがルームに参加できないまま
#    通話画面が開くので「双方向とも無音・でも文字起こしは出る」という紛らわしい壊れ方をする。
#    VMでは Caddy が livekit.example.com をTLS終端して localhost:7880 へ渡している。
#    LIVEKIT_URL と同じ値にしないこと — 自分の公開IP宛はGCPでヘアピンせずRoom APIが死ぬ。
#    ローカル開発 (http://localhost:3000) では未設定でよい (LIVEKIT_URL にフォールバック)
LIVEKIT_PUBLIC_URL=

# ===== ブラステル My 050 (SIP) =====
# マイアカウント画面から取得:
#   SIPユーザーID → BRASTEL_SIP_USER
#   認証ID       → BRASTEL_SIP_PASSWORD
#   SIPサーバー(ドメインホスト) → BRASTEL_SIP_SERVER
BRASTEL_SIP_USER=
BRASTEL_SIP_PASSWORD=
BRASTEL_SIP_SERVER=

# ===== Twilio Elastic SIP Trunking (peer型・非REGISTER) =====
# Twilio Console > Elastic SIP Trunking > Trunk > Termination で作成した Credential List の値
#   Username → TWILIO_SIP_USER / Password → TWILIO_SIP_PASSWORD
#   Termination SIP URI (xxx.pstn.twilio.com) → TWILIO_TERMINATION_URI
# 着信(Origination)はTwilioがREGISTERせず直接INVITEしてくる方式のため、
# Origination URI(Twilio Console側)にこちらの固定IP:5070を設定しておくこと
TWILIO_SIP_USER=
TWILIO_SIP_PASSWORD=
TWILIO_TERMINATION_URI=

# ===== DB (M2.5): 通話履歴 =====
# ホストで動く dashboard 用 (agentコンテナはcompose内でpostgresホスト名を使う)
DATABASE_URL=postgresql://callagent:callagent@localhost:5432/callagent

# ===== 管制室の認証 (値は services/dashboard/.env.local に置く) =====
# next-authはEdge runtimeのmiddlewareで読むため、リポジトリ直下の.envではなく
# services/dashboard/.env.local に AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET / AUTH_SECRET /
# ALLOWED_EMAILS を書く。ここに書いても効かない。
#
# ⚠ 公開ホストで動かす時は AUTH_URL を必ず設定する (例: AUTH_URL=https://fragment.example.com)。
#   未設定だと next-auth が自分のURLを https://localhost:3000 と誤認し、未ログイン時の
#   callbackUrl がそこを指して認証後に戻れない。Host/X-Forwarded-Host を渡しても直らない
#   (PORTからの既定値なので)。ローカル(next dev)では設定しないこと。詳細は services/dashboard/auth.ts

# ===== AIコア (M2) =====
# live (デフォルト: Gemini Live API、速い・自然) / cascade (Deepgram STT+Gemini 3.5 Flash+TTS、賢いが遅い)
AI_CORE=live
# 声 (Live/Gemini TTS共通の30声: Leda=若い女性 / Kore=落ち着いた女性 / Aoede / Zephyr 等)
GEMINI_VOICE=Leda

# ===== 割り込みの閾値 (2026-07-30に実機テストで追加) =====
# 既定(0.5秒・語数制限なし)だと、相手が電話に向けてではなく横で言った独り言や
# 「うん」程度の相槌でAIが文の途中で黙り、相手からは「え、消えた」と見える (実際に言われた)。
# ⚠上げすぎると「もういいです」で切りたい相手を黙らせる無礼な機械になる。
#   変えたら infra/scripts/run_scenarios.py の aizuchi と barge_in を両方回して確認すること
MIN_INTERRUPTION_SEC=0.8
# 語数はSTT結果を使うのでcascade構成でのみ効く (s2sでは秒数だけ)
MIN_INTERRUPTION_WORDS=2

# ===== 声 (TTS) の既定 =====
# ⚠ここは**既定値**にすぎない。実際に使う声は管制室の [設定 > 声] で選べる
#   (settingsテーブルの tts_primary / tts_fallback。agentが通話ごとに読むので再起動不要)。
#   設定側が空文字なら、ここの値が使われる
# aivis / google / gemini / elevenlabs / voicevox
TTS_FALLBACK=google
# ⚠サブを置く理由: 外部APIに声を預けると落ちたときに電話が無言になる。
#   通話で一番痛い障害なので、合成が失敗したら自動で切り替える。none でサブ無し

# ===== Aivis Cloud API (TTS_PROVIDER=aivis、2026-07-30導入) =====
# 声=コハク。https://hub.aivis-project.com/cloud-api でキーを発行 (チャージ式・従量課金)
# 実測: 初回バイト0.08〜0.12秒 / 1万文字¥440 = ¥0.044/字 / 平均228字の通話で約¥10
# ⚠チャージしたクレジットは180日で自動失効。月間利用上限は既定OFF (暴走対策に入れておくとよい)
AIVIS_API_KEY=
# 空ならコハク (22e8ed77-94fe-4ef2-871f-a86f94e9a579) を使う
AIVIS_MODEL_UUID=
# ⚠コハクはゆっくり読む声質。1.0だと挨拶23文字で4.5秒、1.2で3.9秒 (実測)。
#   挨拶は割り込み無効で流すので、秒数を測って決めること
AIVIS_SPEAKING_RATE=1.2
# 音量 0.0〜2.0 (既定1.5)。⚠1.0=「小さい」/2.0=「うるさい」と実機で両方言われた
#   実測RMS: Aivis vol=1.0→2663 / vol=2.0→5133 / Google Chirp3-HD→6665
AIVIS_VOLUME=1.5

# ===== TTS (cascade時のみ使用) =====
# gemini (GOOGLE_API_KEYで動く) / voicevox (要 --profile voicevox、強いマシン向け)
TTS_PROVIDER=gemini
# VOICEVOX話者ID。一覧は curl localhost:50021/speakers (デフォルト 2 = 四国めたん ノーマル)
VOICEVOX_SPEAKER=2

# ===== AI (M2): Gemini Live API =====
# Google AI Studio (aistudio.google.com/api-keys) で発行。GCPプロジェクトのインポートが必要
# 注意: APIキー発行はブラウザ自動化だと弾かれることがある (Google側の不正利用検知)。手動操作で発行すること
GOOGLE_API_KEY=

# ===== 警備: SIP不正利用の検知・遮断 (2026-07-26) =====
# 実装: services/agent/security.py。既定値のままで 2026-07-26 の攻撃 (内線総当たり +
# 英国プレミアム番号への中継) は止まるので、通知先だけ設定すれば十分。
#
# 検知の通知先 (Discord の「サーバー設定 > 連携サービス > ウェブフック」で作ったURL。
# Slack の Incoming Webhook でも可 — URLで自動判別)。未設定なら管制室UIにだけ出る
SECURITY_WEBHOOK_URL=
# 通知文に載せる管制室のURL (例: https://fragment.example.com)
DASHBOARD_URL=
# 自分のDID (カンマ区切り)。着信の宛先がこれ以外の国際番号なら中継の踏み台狙いとして拒否する。
# ブラステルが INVITE の To: に載せてくる表記は揺れるので、迷ったら複数書いておく
# (この項目が効くのは STRICT_CALLEE=1 の時と、自分のDID宛を国際判定から除外する時だけ)
SECURITY_LOCAL_NUMBERS=
# 判定を丸ごと免除する番号 (テスト用ダミー 09012345678 は常に免除)
SECURITY_ALLOW_NUMBERS=
# 1 = 自分のDID宛以外の着信をすべて拒否 (既定0 = 国際発信への中継だけ拒否)。
# ブラステルの宛先表記が揺れると正常な着信まで落ちるので、ログで確認してから有効にすること
SECURITY_STRICT_CALLEE=0
# 0 = 拒否せず検知と通知だけ行う様子見モード (誤検知が心配な時の慣らし運転用)
SECURITY_ENFORCE=1
# これ未満の桁数の発信者番号は内線番号の総当たりとみなす (1001/2000/5001 等)
SECURITY_MIN_CALLER_DIGITS=6
# レート制限: 同一発信者から WINDOW 秒に MAX 件を超えたら BLOCK 秒だけ自動拒否
SECURITY_RATE_MAX=5
SECURITY_RATE_WINDOW_SEC=600
SECURITY_BLOCK_SEC=3600
# 着信ストームの警報しきい値 (番号を変えながらのスキャン検知。遮断はせず通知だけ)
SECURITY_STORM_MAX=12
SECURITY_STORM_WINDOW_SEC=300

# ===== 通話録音の保存期間 =====
# ⚠**0 = 掃除しない (既定)**。8kHzモノラルで約1MB/分なので、放置すれば必ず溜まる。
#   ただし録音は取り返しがつかないので、日数はこちらで決めずに空けてある。
#   有効にする前に、文字起こし (通話記録md) が別に残ることを確認すること —
#   録音は「文字起こしが取りこぼした数字を後から耳で確認する」ための保険なので。
# 例: RECORDING_RETENTION_DAYS=90
RECORDING_RETENTION_DAYS=0

# ===== 不使用 (M2当初のcascade構成用に取得したが Gemini Live API 採用で不要に) =====
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
ELEVEN_API_KEY=

# --- ソフトフォン内線 (2026-09-17) ---
# 「当面のIP電話体制」用。1001=PC親機 / 1002,1003=スマホ子機。
# ⚠公開ポートは開けず Tailscale 経由でのみ REGISTER させる前提の設定
#    (2026-07-26 に 5060 公開でSIPスキャナー侵入とトールフラウドを踏んでいる)。
# 着信時に内線を同時に鳴らす秒数。0 か未設定なら内線を鳴らさない = 内線を作る前と同じ挙動
PHONES_RING_SEC=0
# 各内線の SIP パスワード (24桁程度のランダム推奨)
PHONE_1001_PASSWORD=
PHONE_1002_PASSWORD=
PHONE_1003_PASSWORD=
# 内線から外線発信するときに名乗る番号 (未設定だと非通知になり相手のブロックに弾かれる)
OUTBOUND_CALLERID=

# --- AIコアのモデル指定 (2026-09-18) ---
# live 構成 (AI_CORE=live) の音声→音声モデル。1.8.2 のプラグインが知っているのは
#   gemini-3.8-live / gemini-3.8-live-extended-thinking / gemini-3.1-flash-live-preview /
#   gemini-2.5-flash-native-audio-preview-12-2025 (realtime/api_proto.py の LiveAPIModels)。
# ⚠3.1 は chat_ctx も instructions も途中更新できない = 耳打ち・後方支援メモが届かない。
#   -extended-thinking は思考を挟むぶん遅延が増えるはずなので電話では既定にしない
GEMINI_LIVE_MODEL=gemini-3.8-live
# cascade 構成 (AI_CORE=cascade) のテキストLLM。既定は 3.5-flash。
# ⚠API には 3.6 / 3.7 / 3.8-flash があるが、8/1 に 3.6 でツール呼び出しが本文に溢れて
#   相手に聞こえた (13/45)。上げるなら run_scenarios.py の no_tool_leak で測ってから
GEMINI_TEXT_MODEL=gemini-3.5-flash
# 定型文 (挨拶・無言時の促し・切る前の一言) をモデル自身に言わせる実験用フラグ (2026-09-18)。
# ⚠**既定オフ = 測った結果**。1 にすると barge_in で挨拶が被せ喋りに消え (realtime は割り込みを
#   止められない)、handoff_urgent で request_handoff が呼ばれなくなった (generate_reply が保留中の
#   generation を cancel する巻き添え)。say() は FAIL 1 件、モデル発話は FAIL 4 件。
#   live 構成でも TTS はこの定型文3つのために残す
FIXED_LINES_VIA_MODEL=0

# --- スタンバイの鳴動秒数と、live のターン検出 (2026-09-18) ---
# スタンバイで端末を鳴らす秒数。ユーザーの実機判断で 8 (既定 2)。⚠2.5秒を超えると
#   ワンギリがAI応答前に抜ける。被害が出るのは人が折り返したときなので、折り返す前に
#   管制室の /screen 判定 (国際・プレミアム番号) を見る。AIは折り返さない
STANDBY_RING_SEC=8
# live 構成で「相手の発話が終わった」と判定するまでの沈黙 (ms)。3.8 は既定だと相手の一拍で
#   食い付き、続きが拾われない (aizuchi の no_truncated_ai)。上げすぎると返事が遅れる
LIVE_END_SILENCE_MS=800

# ===== FCM (スマホアプリを起こすプッシュ、2026-09-18) =====
# 押すのは「起きろ」だけ。起きた端末は /api/device/state を取りに来る (判断は hookd のまま)。
# 全部未設定なら押さない = ロングポーリングのみ (据え置き・常時給電の端末ならそれで足りる)。
# self-host は自分の Firebase プロジェクトを使う:
#   firebase apps:create android <名前> --package-name jp.sleeptree.fragment --project <id>
#   firebase apps:sdkconfig ANDROID <appId>   → 下の FCM_ANDROID_* に写す
#   鍵: Firebase Admin SDK のサービスアカウント (roles/firebase.sdkAdminServiceAgent) の JSON を
#       infra/secrets/ に置く
# 送る側 (hookd)。コンテナ内パス
FCM_SERVICE_ACCOUNT=/secrets/fcm-admin.json
# 受ける側 (アプリ)。管制室の /api/device/config が配り、アプリはこれで Firebase を初期化する。
# google-services.json をアプリに焼かないのは、self-host ごとに Firebase が違うため
FCM_PROJECT_ID=
FCM_SENDER_ID=
FCM_ANDROID_APP_ID=
FCM_ANDROID_API_KEY=
